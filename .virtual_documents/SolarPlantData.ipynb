solar_data.iloc[200:220]


# Physics & capacity constants (from clean_data.py)
FAIMAN_U0, FAIMAN_U1 = 25.0, 6.84
STC_IRRADIANCE, STC_TEMP = 1000.0, 25.0
TEMP_COEFFICIENT = -0.004
WIND_KMH_TO_MS = 3.6
PLANT_CAPACITY_KWP = 1000.0


# 1. Fix Wind Speed Units (km/h -> m/s)
solar_data['WIND_SPEED(m/s)'] = solar_data['WIND_SPEED(m/s)'] / WIND_KMH_TO_MS

# 2. Reindex to 15-minute intervals and interpolate missing values
solar_data['DATE_TIME'] = pd.to_datetime(solar_data['DATE_TIME'], errors='coerce')
solar_data = solar_data.sort_values('DATE_TIME').reset_index(drop=True)

full_index = pd.date_range(solar_data['DATE_TIME'].min(), solar_data['DATE_TIME'].max(), freq='15min')
solar_data = solar_data.set_index('DATE_TIME').reindex(full_index)
solar_data.index.name = 'DATE_TIME'

numeric_cols = [c for c in solar_data.columns if c != 'PLANT_ID']
solar_data[numeric_cols] = solar_data[numeric_cols].interpolate(method='time', limit_direction='both')

if 'PLANT_ID' in solar_data.columns:
    solar_data['PLANT_ID'] = solar_data['PLANT_ID'].ffill().bfill().astype(int)

solar_data = solar_data.reset_index()

# 3. Recompute Theoretical Module Temp, Power Outputs, and Residuals
irr = solar_data['IRRADIATION(W/m²)']
wind = solar_data['WIND_SPEED(m/s)']
ambient = solar_data['AMBIENT_TEMPERATURE(°C)']

# Faiman model module temp
mod_temp = ambient + irr / (FAIMAN_U0 + FAIMAN_U1 * wind)
solar_data['THEORETICAL_MODULE_TEMPERATURE(°C)'] = mod_temp

# Theoretical DC & AC outputs
irr_ratio = irr / STC_IRRADIANCE
temp_adj = 1 + TEMP_COEFFICIENT * (mod_temp - STC_TEMP)
dc_per_kwp = np.where(irr <= 0, 0.0, np.maximum(irr_ratio * temp_adj, 0.0))
solar_data['THEORETICAL_DC_PER_KWP'] = dc_per_kwp

actual_dc = solar_data['ACTUAL_DC_POWER(kW)']
actual_ac = solar_data['ACTUAL_AC_POWER(kW)']
inverter_eff = np.where(actual_dc > 0, actual_ac / actual_dc, 0.0)

solar_data['INVERTOR_EFFICIENCY'] = inverter_eff
solar_data['THEORETICAL_AC_PER_KWP'] = dc_per_kwp * inverter_eff

solar_data['THEORETICAL_DC_POWER(kW)'] = solar_data['THEORETICAL_DC_PER_KWP'] * PLANT_CAPACITY_KWP
solar_data['THEORETICAL_AC_POWER(kW)'] = solar_data['THEORETICAL_AC_PER_KWP'] * PLANT_CAPACITY_KWP

solar_data['DC_RESIDUAL(kW)'] = actual_dc - solar_data['THEORETICAL_DC_POWER(kW)']
solar_data['AC_RESIDUAL(kW)'] = actual_ac - solar_data['THEORETICAL_AC_POWER(kW)']

# 4. Refresh Efficiency Columns & Drop redundant column
dc_peak = solar_data['ACTUAL_DC_POWER(kW)'].max()
ac_peak = solar_data['ACTUAL_AC_POWER(kW)'].max()
solar_data['DC_EFFICIENCY'] = solar_data['ACTUAL_DC_POWER(kW)'] / dc_peak
solar_data['AC_EFFICIENCY'] = solar_data['ACTUAL_AC_POWER(kW)'] / ac_peak

if 'CALCULATED_PLANT_CAPACITY(kWp)' in solar_data.columns:
    solar_data = solar_data.drop(columns=['CALCULATED_PLANT_CAPACITY(kWp)'])


solar_data.to_csv('SOLAR_PLANT_DATA(GENERATION_AND_WEATHER)2.csv', index=False)
